// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STREAMER
  ADMIN
  MODERATOR
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  role          Role      @default(USER)
  avatar        String?
  bio           String?
  cover         String?
  tiktokActive    Boolean   @default(false)
  tiktokUrl       String?
  instagramActive Boolean   @default(false)
  instagramUrl    String?
  youtubeActive   Boolean   @default(false)
  youtubeUrl      String?
  facebookActive  Boolean   @default(false)
  facebookUrl     String?
  isLive        Boolean   @default(false)
  statusActive  Boolean   @default(true)
  canPost       Boolean   @default(true)
  canChat       Boolean   @default(true)
  isVerified    Boolean   @default(false)
  
  // Relations
  stream        Stream?
  wallet        Wallet?
  posts         Post[]
  
  following     Follow[]  @relation("Following")
  followers     Follow[]  @relation("Followers")
  
  notifications Notification[]
  
  reportsMade   ModerationReport[] @relation("Reporter")
  reports       ModerationReport[] @relation("ReportedUser")

  messages      Message[]

  likes         PostLike[]
  savedPosts    SavedPost[]
  sentDMs       DirectMessage[] @relation("SentDirectMessages")
  receivedDMs   DirectMessage[] @relation("ReceivedDirectMessages")
  comments      Comment[]
  commentLikes  CommentLike[]
  
  tournamentsCreated       Tournament[]
  tournamentParticipations TournamentParticipant[]
  createdRooms             GameRoom[]              @relation("CreatedRooms")
  joinedRooms              GameRoom[]              @relation("JoinedRooms")
  rechargeRequests         RechargeRequest[]
  withdrawalRequests       WithdrawalRequest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum PostType {
  IMAGE
  VIDEO
}

model Post {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        PostType
  isPrivate   Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       PostLike[]
  savedBy     SavedPost[]
  comments    Comment[]
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Int      @default(0)
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactions Transaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  GIFT_SENT
  GIFT_RECEIVED
  TOURNAMENT_FEE
  TOURNAMENT_PRIZE
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Int
  type        TransactionType
  
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  
  // Optional relations depending on transaction type
  giftId      String?
  gift        Gift?    @relation(fields: [giftId], references: [id])
  
  referenceId String?  // ID of the other user/stream/battle involved
  
  createdAt   DateTime @default(now())
}

model Gift {
  id          String   @id @default(cuid())
  name        String
  price       Int
  icon        String
  animationUrl String?
  
  transactions Transaction[]
}

model Stream {
  id          String   @id @default(cuid())
  title       String
  thumbnail   String?
  isLive      Boolean  @default(false)
  category    String?
  
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages    Message[]
  liveRoom    LiveRoom?
  
  battles1    StreamBattle[] @relation("Stream1")
  battles2    StreamBattle[] @relation("Stream2")
  reports     ModerationReport[]

  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveRoom {
  id          String   @id @default(cuid())
  streamId    String   @unique
  activeViewers Int    @default(0)
  totalViews  Int      @default(0)
  likes       Int      @default(0)
  
  stream      Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  content   String
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  isGift    Boolean  @default(false)
  giftId    String?

  createdAt DateTime @default(now())
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String

  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

enum BattleStatus {
  PENDING
  ONGOING
  FINISHED
  CANCELLED
}

model StreamBattle {
  id          String   @id @default(cuid())
  stream1Id   String
  stream2Id   String
  
  points1     Int      @default(0)
  points2     Int      @default(0)
  
  winnerId    String?
  
  status      BattleStatus @default(PENDING)
  
  stream1     Stream   @relation("Stream1", fields: [stream1Id], references: [id])
  stream2     Stream   @relation("Stream2", fields: [stream2Id], references: [id])
  
  startTime   DateTime?
  endTime     DateTime?
  
  createdAt   DateTime @default(now())
}

enum NotificationType {
  NEW_FOLLOWER
  STREAM_STARTED
  GIFT_RECEIVED
  BATTLE_INVITE
  SYSTEM
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType
  content     String
  isRead      Boolean  @default(false)
  link        String?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

model ModerationReport {
  id          String   @id @default(cuid())
  reporterId  String
  reportedId  String
  streamId    String?
  
  reason      String
  details     String?
  status      ReportStatus @default(PENDING)
  
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id])
  reported    User     @relation("ReportedUser", fields: [reportedId], references: [id])
  stream      Stream?  @relation(fields: [streamId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  mediaUrl   String?
  mediaType  String?  // 'IMAGE' | 'VIDEO' | 'AUDIO'
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

model Tournament {
  id            String   @id @default(cuid())
  title         String
  game          String   @default("Free Fire")
  format        String   @default("BO3") // "BO3" (Best of 3 PvP) | "BR" (Battle Royale)
  prize         Int
  entryFee      Int      @default(0)
  maxTeams      Int      @default(16)
  status        String   @default("UPCOMING") // "UPCOMING" | "ONGOING" | "FINISHED"
  roomCode      String?
  roomPassword  String?
  
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  participants  TournamentParticipant[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TournamentParticipant {
  id                String   @id @default(cuid())
  tournamentId      String
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  freeFireId        String?
  freeFireName      String?
  
  winScreenshot     String?  // Match 1
  match2Screenshot  String?  // Match 2
  match3Screenshot  String?  // Match 3
  profileScreenshot String?
  submittedWin      Boolean  @default(false)
  isWinner          Boolean  @default(false)
  
  createdAt         DateTime @default(now())

  @@unique([tournamentId, userId])
}

model GameRoom {
  id            String   @id @default(cuid())
  title         String   // ¿Para qué es el PvP? (Pase, evolutiva, etc.)
  game          String   @default("Free Fire")
  wager         Int      @default(0) // Apuesta en monedas
  roomCode      String   // ID de Sala (oculto hasta pagar)
  roomPassword  String   // Contraseña de Sala (oculta hasta pagar)
  status        String   @default("WAITING") // "WAITING" | "PLAYING" | "FINISHED" | "APPROVED"
  
  creatorId     String
  creator       User     @relation("CreatedRooms", fields: [creatorId], references: [id], onDelete: Cascade)
  
  opponentId    String?
  opponent      User?    @relation("JoinedRooms", fields: [opponentId], references: [id], onDelete: Cascade)
  
  winnerId      String?  // ID del ganador reportado
  winScreenshot String?  // Captura de pantalla de victoria
  submittedWin  Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformRevenue {
  id          String   @id @default(cuid())
  amount      Int      // 30% cut
  giftName    String
  senderId    String
  receiverId  String
  createdAt   DateTime @default(now())
}

model RechargeRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins       Int
  priceAmount Float
  status      String   @default("PENDING") // "PENDING" | "COMPLETED" | "REJECTED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins         Int      // Total coins requested to withdraw
  payoutAmount  Float    // 70% in USD
  platformCut   Float    // 30% in USD
  paymentDetails String   // Bank details entered by user
  status        String   @default("PENDING") // "PENDING" | "COMPLETED" | "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
